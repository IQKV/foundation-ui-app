# API Configuration
VITE_API_SERVER_URL=https://api.iqkv.site/api

# Log level: 'silent', 'info', 'debug'
VITE_LOG_LEVEL=info

# Platform-wide operational mode: 'MULTI_TENANT' (default) or 'SINGLE_TENANT'
VITE_ROLLOUT_MODE=MULTI_TENANT

# Demo mode: 'true' or 'false' (default)
VITE_DEMO_MODE=false

# Magic link authentication: 'true' (default) or 'false'
VITE_ENABLE_MAGIC_LINK=true
